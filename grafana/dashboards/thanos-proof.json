{
  "uid": "thanos-proof",
  "title": "Thanos Proof: Prometheus vs. S3",
  "description": "Same query through both data sources. Prometheus keeps 6h, so anything older can only come from S3 through Thanos.",
  "tags": ["thanos", "demo"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prometheus directly (6h retention)",
      "description": "Stops about 6 hours back.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "CPU usage"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Through Thanos (Prometheus + S3)",
      "description": "Data older than 6 hours comes from S3 via the store gateway.",
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "CPU usage"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocks in S3",
      "description": "Number of blocks the store gateway has loaded from the bucket.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(thanos_bucket_store_blocks_loaded)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocks uploaded by the sidecar",
      "description": "Counter resets when the Prometheus pod restarts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(thanos_shipper_uploads_total)"
        }
      ]
    }
  ]
}
