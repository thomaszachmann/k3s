    {
      "type": "timeseries",
      "title": "CPU je Cluster",
      "description": "Genutzte CPU-Zeit aller Nodes eines Clusters, ohne idle, iowait und steal.",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (cluster) (rate(node_cpu_seconds_total{job=\"node-exporter\", mode!~\"idle|iowait|steal\", cluster=~\"$cluster\"}[$__rate_interval])) / count by (cluster) (node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\", cluster=~\"$cluster\"})",
          "editorMode": "code",
          "legendFormat": "{{cluster}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
