{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketAuflisten",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::PRAEFIX-obs-tempo"
    },
    {
      "Sid": "ObjekteLesenSchreibenLoeschen",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject",
        "s3:GetObjectTagging", "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::PRAEFIX-obs-tempo/*"
    }
  ]
}
